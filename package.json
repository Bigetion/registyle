{
  "name": "registyle",
  "version": "2.0.3",
  "description": "Semantic CSS registration with an optional Tailwind CSS v4 Vite build adapter",
  "homepage": "https://github.com/Bigetion/registyle#readme",
  "bugs": {
    "url": "https://github.com/Bigetion/registyle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bigetion/registyle.git"
  },
  "type": "module",
  "main": "./core-entry.js",
  "module": "./core-entry.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./core-entry.js",
      "default": "./core-entry.js"
    },
    "./compile": {
      "types": "./compile.d.ts",
      "import": "./compile.js"
    },
    "./collector": {
      "types": "./collector.d.ts",
      "import": "./collector.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.js"
    },
    "./theme": {
      "types": "./theme.d.ts",
      "import": "./theme.js"
    },
    "./variants": {
      "types": "./variants.d.ts",
      "import": "./variants.js"
    }
  },
  "files": [
    "core-entry.js",
    "core-runtime.js",
    "compile.js",
    "compile.d.ts",
    "collector.js",
    "collector.d.ts",
    "vite.js",
    "vite.d.ts",
    "virtual.d.ts",
    "docs/README.md",
    "docs/API.md",
    "docs/INTEGRATIONS.md",
    "docs/CODESANDBOX.md",
    "docs/ADVANCED.md",
    "docs/CHANGELOG.md",
    "docs/MIGRATION.md",
    "docs/TROUBLESHOOTING.md",
    "optimize.js",
    "theme.js",
    "theme.d.ts",
    "variants.js",
    "variants.d.ts",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test && npm run test:types && npm run test:codesandbox",
    "test:types": "tsc --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ESNext type-tests/consumer.ts",
    "test:codesandbox": "node test/codesandbox-detection.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.1",
    "vite": "^6.4.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.1",
    "vite": "^6.4.3"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": { "optional": true },
    "postcss": { "optional": true },
    "postcss-selector-parser": { "optional": true },
    "vite": { "optional": true }
  },
  "keywords": [
    "css",
    "semantic-css",
    "register",
    "tailwindcss",
    "tailwindcss-v4",
    "vite",
    "design-system",
    "utility-first",
    "css-in-js",
    "variants",
    "themes"
  ],
  "license": "MIT"
}